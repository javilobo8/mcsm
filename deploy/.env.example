# Image version (ghcr.io/javilobo8/mcsm-panel and mcsm-agent), e.g. 0.11.0; empty = latest
MCSM_VERSION=
# IP or hostname the nodes and your browser use to reach the panel
PANEL_PUBLIC_URL=http://192.168.1.10:8080
# Optional: initial setup token the web asks for when creating the password
# (empty = the panel generates one and writes it to its log). Use a long, random value.
# PANEL_SETUP_TOKEN=
# Host directory (ABSOLUTE path) where THIS machine's worlds live
DATA_ROOT=/srv/minecraft
# Enrollment token for the local agent (generate one in Nodes → Add node the first time)
ENROLL_TOKEN=
# Optional: maximum size of a file upload on this node, in bytes (default 4 GiB)
# UPLOAD_MAX_BYTES=4294967296
